# TEMPLATE - do not cp this verbatim. %h/cortana and the X cookie path are
# assumptions that break on any other checkout location or display manager.
#
# Install (as the cortana user):
#   bash install-services.sh        # resolves paths, venv and X cookie for you
#   systemctl --user start cortana
# Logs: journalctl --user -u cortana -f
[Unit]
Description=Cortana voice assistant
After=graphical-session.target sound.target network-online.target

[Service]
WorkingDirectory=%h/cortana
ExecStart=%h/cortana/venv/bin/python %h/cortana/launcher.py
# Relaunch on ANY exit (clean restart exit 0, or a crash) EXCEPT a
# deliberate shutdown. main.py/launcher.py exit 42 (config.SHUTDOWN_CODE)
# means "stay down". This makes restart work at the systemd layer even
# if launcher.py is ever bypassed and main.py is run directly.
Restart=always
RestartPreventExitStatus=42
RestartSec=2
Environment=DISPLAY=:0
# %t = /run/user/<uid> (never hardcode the uid - this file used to say
# 1001, which was one machine's user and silently broke screenshots and
# hotkeys everywhere else). install-services.sh replaces this with the
# cookie this machine actually has.
Environment=XAUTHORITY=%t/gdm/Xauthority

[Install]
WantedBy=default.target

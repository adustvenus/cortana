# Dusk Dashboard - systemd user unit. Independent of cortana.service on
# purpose: restarting Cortana never touches the dashboard, and vice versa.
#
# Install (as the cortana user):
#   cp Dashboard/cortana-dash.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cortana-dash
# Logs: journalctl --user -u cortana-dash -f
[Unit]
Description=Dusk Dashboard (Cortana status display)
After=graphical-session.target

[Service]
WorkingDirectory=%h/cortana/Dashboard/app
ExecStart=%h/cortana/Dashboard/app/dusk-dash.sh
Restart=on-failure
RestartSec=3
Environment=DISPLAY=:0
# %t = /run/user/<uid> (never hardcode the uid). GDM-on-Xorg keeps the cookie
# here; on other display managers point this at your $XAUTHORITY (echo it in a
# terminal) or drop the line if ~/.Xauthority is used.
Environment=XAUTHORITY=%t/gdm/Xauthority

[Install]
WantedBy=default.target

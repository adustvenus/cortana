# Copy to .env and fill in. Never commit .env anywhere.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...

# Anything specific to ONE machine (mic index, VAD threshold) belongs in
# .env.local, not here - ./secrets.sh overwrites .env on every pull.
# Optional overrides
# ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# WORKSPACE=/home/cortana/workspace
# MODE=ptt                # ptt | wake | open
# MIC_DEVICE=             # int index from: python -c "import sounddevice as sd; print(sd.query_devices())"
# VAD_THRESHOLD=350       # raise if room noise falsely triggers listening
# DUCK_ENABLED=1          # lower Spotify while she's listening/speaking, restore after
# DUCK_SINK_MATCH=spotifyd
# DUCK_FACTOR=0.25
# BUDGET_MONTHLY_USD=50
# MODEL_LEAD=claude-sonnet-5          # voice lead; set to claude-opus-5 for max quality
# MODEL_FAST=claude-haiku-4-5         # wake gate + critique (no reasoning)
# MODEL_HEAVY=claude-opus-5           # dev/subagent work
# EFFORT_LEAD=medium                  # low|medium|high|xhigh|max - reasoning depth
# EFFORT_HEAVY=high
# MAX_TOKENS=8192                     # ceiling per reply; thinking spends against it
# CACHE_ENABLED=1                    # cache the stable prompt prefix (tools+system+docs)
# CACHE_TTL=1h                       # 1h or 5m; 1h costs more to write, less to re-write

# --- Mobile bridge (phone link; see mobile/README.md) ---
# BRIDGE_PORT=8765        # phone app + MOBILE LINK dashboard module use this
# BRIDGE_BIND=0.0.0.0     # keep unreachable from the internet - Tailscale/LAN only
# BRIDGE_NAME=            # name the phone shows for this machine (default: hostname)

# ── New feature switches (all optional; every one ships safe by default) ──
# Synthetic keystrokes into whatever window has focus. OFF, and it should stay
# off unless you have a specific reason - there is no undo.
# DESKTOP_TYPE_ENABLED=1

# Offline wake word. Empty = dormant, wake mode still transcribes first exactly
# as before. Set to openwakeword once voice/models/cortana.onnx exists.
# WAKEWORD_ENGINE=openwakeword
# WAKEWORD_THRESHOLD=0.5
# PICOVOICE_ACCESS_KEY=

# faster-whisper instead of the Whisper API. Leave OFF on the runtime box: it
# holds ~1 GB resident out of the 2 GB free, to save an API call worth pennies.
# STT_USE_LOCAL=1

# US ZIP for the morning brief's weather clause. Empty = no clause, no call.
# BRIEF_ZIP=

# Sentinel thresholds are absolute free MB, not percentages - an allocation
# fails at an absolute number of free bytes regardless of how big the box is.
# SENTINEL_MEM_WARN_MB=600
# SENTINEL_MEM_BAD_MB=300

# Home fix for the phone's coarse home/out call. These describe a PLACE, not a
# machine, so they belong in .env.local - secrets.sh overwrites .env on pull.
# HOME_LAT=
# HOME_LON=

<?xml version="1.0" encoding="utf-8"?>
<!-- The Cortana orb, matching the Dusk dashboard exactly. The dashboard paints
     it as radial-gradient(circle at 35% 30%, peach, rose 55%, orb-purple):
       peach   255,217,196  #ffd9c4
       accent2 240,138,155  #f08a9b
       orb     143,123,184  #8f7bb8
     Used by the launcher icon, the 2x2 widget, the talk screen and pairing.
     (XML forbids a double hyphen inside comments.) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- depth: purple base so edges fall away like the dashboard orb -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="58%p"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#a892d6"
                android:centerColor="#8f7bb8"
                android:endColor="#5d4f82" />
        </shape>
    </item>
    <!-- the lit face: peach highlight into rose, offset up-left at 35%/30% -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="62%p"
                android:centerX="0.35" android:centerY="0.30"
                android:startColor="#ffd9c4"
                android:centerColor="#f08a9b"
                android:endColor="#008f7bb8" />
        </shape>
    </item>
    <!-- coral rim, the dashboard's accent -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#7dffab8f" />
        </shape>
    </item>
</layer-list>

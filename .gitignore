# --- Secrets (NEVER commit; self-edit auto-pushes to GitHub) ---
.env
credentials.json
token.json

# --- Runtime state / artifacts ---
state.db
hud_state.json
*.tmp
.last_good
pending_edit.json
pending_diff.txt

# --- Audio / scratch (kept out so self-edit can't push them) ---
*.wav
*.log
scratch/
tmp/

# --- Python ---
__pycache__/
*.py[cod]
venv/
.venv/

# Self-edit backup files
*.bak

# Dashboard app (Electron installed per-machine by install-dash.sh)
Dashboard/app/node_modules/
Dashboard/app/package-lock.json

# Spotify OAuth token (refresh token is a secret; Client ID stays in spotify.json)
Dashboard/app/spotify_token.json

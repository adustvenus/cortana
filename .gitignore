# --- Secrets (NEVER commit; self-edit auto-pushes to GitHub) ---
.env
.env.local
credentials.json
token.json

# --- Runtime state / artifacts ---
state.db
# WAL sidecars. journal_mode=WAL is set in memory.init() and is a PERSISTENT
# property of the db file, so these two appear the moment she runs - and
# self-edit auto-commits, which would otherwise sweep live db internals into
# the repo.
state.db-wal
state.db-shm
hud_state.json
calendar_state.json
presence_desk.json
speech_inbox.json
sentinel_state.json
mic_state.json
mic_select.json
*.tmp
.last_good
pending_edit.json
pending_diff.txt

# --- Audio / scratch (kept out so self-edit can't push them) ---
*.wav
*.log
scratch/
tmp/

# --- Python ---
__pycache__/
*.py[cod]
venv/
.venv/

# Self-edit backup files
*.bak

# Dashboard app (Electron installed per-machine by install-dash.sh)
Dashboard/app/node_modules/
Dashboard/app/package-lock.json

# Spotify OAuth token (refresh token is a secret) + per-machine config (holds
# your Client ID). spotify.example.json is the committed template.
Dashboard/app/spotify_token.json
Dashboard/app/spotify.json

# Mobile bridge: paired-phone token hashes + device names (per-machine)
mobile_link.json

# Announcement id counter. Per-machine, and must survive a bridge restart or
# replay to a reconnecting phone breaks (see bridge/hub.py).
announce_seq.json

# Android build outputs (mobile/dist/ IS committed - CI publishes the APK there)
mobile/.gradle/
mobile/build/
mobile/app/build/
mobile/local.properties

# Last working wireless-adb address (per-machine)
.adb_target

# Shared Spotify rate-limit cool-off (per-machine runtime state)
Dashboard/app/spotify_backoff.json

# Last track Spotify reported, so the MUSIC tile keeps showing what is loaded
# after a pause idles the device out or the shell restarts. Per-machine runtime
# state, like the backoff file beside it.
Dashboard/app/spotify_last.json

# Android release signing key. NEVER commit - CI reads it from the
# CORTANA_KEYSTORE_B64 repo secret. (An earlier one leaked here publicly.)
mobile/keystore/*.p12
mobile/keystore/*.jks

# spotifyd per-machine config (names a cache_path holding live session
# data). spotifyd.conf.example is the committed template.
Dashboard/spotifyd.conf
